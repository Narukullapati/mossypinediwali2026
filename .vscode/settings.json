{
  "workbench.colorTheme": "GitHub Dark",
  "workbench.colorCustomizations": {
    "editor.background": "#0d1512",
    "editor.foreground": "#e5f5ec",
    "editorLineNumber.foreground": "#5f7f6f",
    "editorLineNumber.activeForeground": "#4ade80",
    "editorCursor.foreground": "#22c55e",
    "editor.selectionBackground": "#22c55e55",
    "editor.inactiveSelectionBackground": "#22c55e33",
    "editor.selectionHighlightBackground": "#22c55e22",
    "editor.wordHighlightBackground": "#22c55e33",
    "editor.findMatchBackground": "#22c55e99",
    "editor.findMatchHighlightBackground": "#22c55e44",
    "editorBracketMatch.background": "#22c55e33",
    "editorBracketMatch.border": "#22c55e",
    "editorIndentGuide.background1": "#23402f",
    "editorIndentGuide.activeBackground1": "#22c55e",
    "editorGutter.modifiedBackground": "#22c55e",
    "editorGutter.addedBackground": "#5eead4",
    "editorGutter.deletedBackground": "#fb7185",
    "activityBar.background": "#0a120e",
    "activityBar.foreground": "#e5f5ec",
    "activityBar.activeBorder": "#22c55e",
    "activityBarBadge.background": "#15803d",
    "activityBarBadge.foreground": "#ffffff",
    "sideBar.background": "#12211a",
    "sideBar.foreground": "#d9efe2",
    "sideBar.border": "#23402f",
    "sideBarSectionHeader.background": "#16281f",
    "sideBarSectionHeader.foreground": "#e5f5ec",
    "list.activeSelectionBackground": "#15803d",
    "list.activeSelectionForeground": "#ffffff",
    "list.hoverBackground": "#1d3829",
    "statusBar.background": "#15803d",
    "statusBar.foreground": "#ffffff",
    "titleBar.activeBackground": "#0a120e",
    "titleBar.activeForeground": "#e5f5ec",
    "menu.background": "#0a120e",
    "menu.foreground": "#e5f5ec",
    "menu.selectionBackground": "#15803d",
    "menu.selectionForeground": "#ffffff",
    "menu.border": "#23402f",
    "menubar.selectionBackground": "#15803d",
    "menubar.selectionForeground": "#ffffff",
    "panel.background": "#0d1512",
    "panel.border": "#23402f",
    "panelTitle.activeForeground": "#e5f5ec",
    "panelTitle.inactiveForeground": "#8fa898",
    "terminal.background": "#0a120e",
    "terminal.foreground": "#e5f5ec",
    "terminal.selectionBackground": "#22c55e55",
    "terminalCursor.foreground": "#22c55e",
    "terminal.border": "#23402f",
    "debugConsole.background": "#0d1512",
    "debugConsoleInputIcon.foreground": "#22c55e",
    "outputView.background": "#0d1512",
    "focusBorder": "#22c55e",
    "button.background": "#15803d",
    "button.hoverBackground": "#1da653",
    "scrollbarSlider.background": "#5f7f6fAA",
    "scrollbarSlider.hoverBackground": "#74937fAA",
    "notifications.background": "#12211a",
    "notifications.foreground": "#e5f5ec",
    "notificationCenterHeader.background": "#0a120e"
  },
  "editor.fontSize": 14,
  "editor.tabSize": 2,
  "editor.wordWrap": "on",
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "explorer.compactFolders": false,
  "files.exclude": {
    "**/.angular": true,
    "**/dist": true,
    "**/.git": true
  },
  "search.exclude": {
    "**/.angular": true,
    "**/dist": true
  },
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  },
  "files.trimTrailingWhitespace": true,
  "window.title": "${activeFolderShort}${separator}${activeEditorShort}",
  "workbench.startupEditor": "welcomePage"
}
